# Knowledge API — скопируй в app/.env и подставь значения (не коммитить)
#
# Загрузка: pydantic-settings читает `.env` в cwd и `app/.env` (см. app/config.py).
#
# --- Лимиты длины (строго из кода приложения, где есть проверки) ---
# • POST /v1/auth/login (форма входа в браузере): пароль в JSON — от 1 до 512 символов включительно
#   (app/routers/auth_api.py, LoginBody.password).
# • Переменные ниже в .env pydantic не режет по длине; «не пусто» для паролей означает строку,
#   отличную от пустой (см. has_session_credentials в app/config.py).
# • Рекомендуемая длина для секретов/ключей в проде — см. комментарии у каждой переменной.

# Куда писать SQLite-метаданные и Chroma (по умолчанию: каталог data рядом с app/)
APP_DATA_DIR=

# Опционально (Docker/compose): порт на хосте в сообщении "Open: …" в логе (как в браузере).
# В docker-compose.yml задаётся через KNOWLEDGE_API_PORT на хосте и APP_EXPOSED_PORT внутри сервиса.
# APP_EXPOSED_PORT=8002

# -----------------------------------------------------------------------------
# Аутентификация
# -----------------------------------------------------------------------------
# Если не задан ни API-ключ, ни env-учётки ADMIN_* / DEMO_* — dev-режим без проверки (только локально).
# Если заданы ADMIN_* и/или DEMO_* — auth обязательна даже без SESSION_SECRET, но браузерный вход по паролю
# включится только при SESSION_SECRET + непустых учётках (см. is_session_login_configured в app/config.py).

# APP_API_KEY — legacy: один ключ, полный доступ (admin), тенант env_admin.
# APP_ADMIN_KEY / APP_MEMBER_KEY — RBAC: admin — разделы, ingest, audit; member — чтение + чат + export.
# Заголовок: X-API-Key: <значение> или Authorization: Bearer <значение>
#
# Длина в коде не ограничена (любая непустая строка-совпадение). Для стойкости к перебору в проде:
# рекомендуется не короче 32 символов на ключ (лучше случайные 32+ байта в hex/urlsafe).
APP_API_KEY=
APP_ADMIN_KEY=
APP_MEMBER_KEY=

# Подпись cookie для Starlette SessionMiddleware (имя cookie: knowledge_session).
# Алиас: APP_SESSION_SECRET.
#
# Требование приложения: непустая строка после trim, иначе браузерный login/logout отключены (503 на POST /v1/auth/login).
# Минимальной длины в коде нет. Для прода рекомендуется не короче 32 символов энтропии
# (например `openssl rand -hex 32` → 64 шестнадцатеричных символа).
# SESSION_SECRET=
# APP_SESSION_SECRET=

# ADMIN_LOGIN + ADMIN_PASSWORD — вход env-admin в браузере (полный доступ к env_admin).
# ADMIN_PASSWORD: в приложении не должно быть пустой строки, если пара должна считаться заданной;
# при входе через форму пароль дополнительно ограничен API: 1–512 символов (см. блок «Лимиты длины» выше).
# ADMIN_LOGIN=
# ADMIN_PASSWORD=

# DEMO_ENABLED=true и непустые DEMO_LOGIN / DEMO_PASSWORD — учётка demo (site_role=demo, tenant env_demo).
# DEMO_PASSWORD: те же правила, что у ADMIN_PASSWORD (непустая в env; при логине через форму — 1–512 символов).
# DEMO_ENABLED=false
# DEMO_LOGIN=
# DEMO_PASSWORD=

# Откуда DEMO (env_demo) читает разделы/документы.
# Приоритет: DEMO_WORKSPACE_TENANT_ID, затем DEMO_WORKSPACE_SHARE_TOKEN; иначе пустой каталог env_demo.
# DEMO_WORKSPACE_TENANT_ID — имя каталога tenants/<id>/ (UUID из панели пользователей или env_admin).
# Перед стартом для shadow (не env_demo) должен существовать файл tenants/<id>/metadata.db.
#
# DEMO_WORKSPACE_SHARE_TOKEN — секрет как у «импорта по ключу» (таблица share_links в registry.db).
# Если токен задан, но не найден в текущем registry.db (старый деплой, другая БД) — он игнорируется, demo читает пустой env_demo; в лог — WARNING.
# Длина в коде не валидируется; токены, которые выдаёт POST /v1/collections/.../share, генерируются как
# secrets.token_urlsafe(48) — обычно около 64 символов (латиница, цифры, -, _).
# DEMO_WORKSPACE_TENANT_ID=
# DEMO_WORKSPACE_SHARE_TOKEN=

# -----------------------------------------------------------------------------
# Polza (OpenAI-совместимый /chat/completions). По умолчанию внешний вызов LLM выключен.
# -----------------------------------------------------------------------------
POLZA_API_KEY=
# Полный ключ провайдера; длина задаётся провайдером. В приложении при загрузке из env не режется.

# Абсолютный URL (http:// или https://). В Docker при ошибке DNS к API — см. app/docs/troubleshooting.md;
# в docker-compose задан resolv 8.8.8.8.
POLZA_BASE_URL=https://polza.ai/api/v1

# Текстовая модель для RAG-чата (не image-only)
POLZA_CHAT_MODEL=openai/gpt-4o-mini

# Температура /chat/completions (0 = детерминированнее; по умолчанию 0)
POLZA_TEMPERATURE=0

# Необязательно: через запятую; если задано — POLZA_CHAT_MODEL должен входить в список при ALLOW_LLM_EGRESS=true
# POLZA_CHAT_MODEL_ALLOWLIST=openai/gpt-4o-mini,openai/gpt-4o

# Разрешить исходящие запросы к LLM (false — только retrieval + локальный ответ с цитатами)
# ALLOW_LLM_EGRESS=false

# -----------------------------------------------------------------------------
# Лимиты ingest/RAG (обязательны в окружении; в репозитории — в `app/.env`)
# -----------------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=200
RETRIEVAL_TOP_K=8

# Подробные логи и traceback в JSON при X-Debug: 1 (веб-админка). В проде часто: false
# APP_ALLOW_CLIENT_DEBUG=true

# Браузер: CORS. По умолчанию * — не «Failed to fetch» при UI с другого origin.
# Список через запятую: http://localhost:3000,https://app.example.com
# APP_CORS_ORIGINS=*

# Если UI открыт с другого хоста/порта — абсолютный URL API (без слеша в конце), тот же, что в браузере для /v1/...
# APP_PUBLIC_BASE_URL=http://127.0.0.1:8002

# -----------------------------------------------------------------------------
# Безопасность прод (middleware + лимиты; см. CHANGELOG от 2026-05-12)
# -----------------------------------------------------------------------------
# Флаг Secure у cookie knowledge_session — true только когда браузер ходит по HTTPS иначе сессия пропадёт.
# SESSION_COOKIE_HTTPS_ONLY=false
#
# Reverse proxy (Traefik): включить расчёт client IP из X-Forwarded-For и т.п.
# TRUST_PROXY_HEADERS=false
# TRUST_PROXY_HOSTS=*
#
# Login brute-force по IP (0 = без лимита для этого окна / отключено):
# RATE_LIMIT_AUTH_LOGIN_MAX=30
# RATE_LIMIT_AUTH_LOGIN_WINDOW_SEC=900
#
# Грубо: лимит POST к /v1/* за окно (кроме /v1/health и /v1/auth/login). 0 = выключено.
# RATE_LIMIT_V1_POST_MAX=200
# RATE_LIMIT_V1_POST_WINDOW_SEC=60
#
# Минимальный интервал (миллисекунды) между исходящими запросами к LLM одним субъектом principal.
# 0 = без лимита; 1000 ~ не чаще 1 раз/сек; 60000 ~ раз в минуту (зависит от фактического времени между вызовами).
# LLM_MIN_INTERVAL_MS=0
#
# Полностью убрать OpenAPI UI:
# APP_OPENAPI_DISABLED=false
#
# Закрыть /docs /redoc /openapi.json базовым auth (оставить OpenAPI включённым). Оба параметра задаются разом:
# APP_DOCS_BASIC_AUTH_USER=
# APP_DOCS_BASIC_AUTH_PASSWORD=

# -----------------------------------------------------------------------------
# Telegram — отдельные сценарии/уведомления (если используешь)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
